  "disagreements_analysis": [
    {
      "clause_id": "emp_indemnity_01",
      "gold_label": "AMBER",
      "annotator_1": {
        "label": "AMBER",
        "full_response": "AMBER \u2014 Lawful under Section 124 of the Indian Contract Act and properly limited to gross negligence or willful misconduct, but unilateral and uncapped in an employment context."
      },
      "annotator_2": {
        "label": "GREEN",
        "reason": "The indemnity is limited to gross negligence or wilful misconduct and to direct losses, which is a market-standard scope. Borderline AMBER because it is one-way and has no cap."
      }
    },
    {
      "clause_id": "rental_lockin_01",
      "gold_label": "RED",
      "annotator_1": {
        "label": "RED",
        "full_response": "RED \u2014 An absolute 24-month prohibition on tenant termination \"regardless of circumstances\" without an exit mechanism or force majeure/breach exception conflicts with Sections 56 and 74 of the Contract Act and Section 108(e) of the Transfer of Property Act."
      },
      "annotator_2": {
        "label": "AMBER",
        "reason": "Lock-ins are lawful, but this one binds only the tenant, is long, and says \"regardless of circumstances\". That wording cannot override frustration (s.56) or the tenant's remedies if the landlord breaches, so enforcement is limited to reasonable damages."
      }
    },
    {
      "clause_id": "rental_maintenance_02",
      "gold_label": "RED",
      "annotator_1": {
        "label": "RED",
        "full_response": "RED \u2014 Shifting 100% of structural repairs, roof leakages, and municipal property taxes onto the tenant contravenes statutory landlord obligations under the Transfer of Property Act and Model Tenancy Act."
      },
      "annotator_2": {
        "label": "AMBER",
        "reason": "Parties can contract around the default rules on repairs, so this is lawful but highly one-sided. Structural repairs and property tax are normally the owner's liability (the owner stays liable to the municipality regardless of the contract)."
      }
    }
  ],
